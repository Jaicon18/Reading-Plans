+                           "código del trade, (C) Otro, en ese orden")
+def a_rfi_formato(ctx):
+    if not ctx.excel or not os.path.isfile(ctx.excel):
+        return []
+    import openpyxl
+    try:
+        ws = openpyxl.load_workbook(ctx.excel, read_only=True)["Pending Items"]
+    except KeyError:
+        return _lista("Pending Items", "no está", "hoja Pending Items con las opciones (A) / (B) / (C) (R80e.50)")
+    filas = [list(r) for r in ws.iter_rows(values_only=True)]
+    if not filas:
+        return []
+    cab = [str(c or "") for c in filas[0]]
+    if cab[:3] != ["RFI", "Question / condition", "Delta of each alternative"] or any(c.strip() for c in cab[3:]):
+        return _lista("Pending Items", " | ".join(cab)[:120], "formato fijo: RFI | Question / condition | Delta of each "
+                                                              "alternative (nunca columnas nuevas, R80e.50)")
+    rx = re.compile(r"\(A\)\s*\S.*\|\s*\(B\)\s*\S.*\|\s*\(C\)", re.S)
+    return [(str(r[0]), str(r[2] or "")[:80], "Delta of each alternative = '(A) plans / specs | (B) trade code | (C) Other' "
+                                               "(R80e.50)") for r in filas[1:] if r and r[0] and not rx.search(str(r[2] or ""))]
