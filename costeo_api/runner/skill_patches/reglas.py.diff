+                           "código del trade, (C) Otro, en ese orden")
+def a_rfi_formato(ctx):
+    if not ctx.excel or not os.path.isfile(ctx.excel):
+        return []
+    import openpyxl
+    try:
+        ws = openpyxl.load_workbook(ctx.excel, read_only=True)["Pending Items"]
+    except KeyError:
+        return _lista("Pending Items", "no está", "hoja Pending Items con las opciones (A) / (B) / (C) (R80e.50)")
+    filas = [list(r) for r in ws.iter_rows(values_only=True)]
+    if not filas:
+        return []
+    cab = [str(c or "") for c in filas[0]]
+    if not (len(cab) >= 6 and cab[3].startswith("(A)") and cab[4].startswith("(B)") and cab[5].startswith("(C)")):
+        return _lista("Pending Items", " | ".join(cab)[:120], "columnas (A) planos / specs, (B) código, (C) Otro (R80e.50)")
+    return [(str(r[0]), "sin opción (A) / (B)", "(A) planos / specs con N/HOJA + delta y (B) código del trade (R80e.50)")
+            for r in filas[1:] if r and r[0] and (not str(r[3] or "").strip() or not str(r[4] or "").strip())]
