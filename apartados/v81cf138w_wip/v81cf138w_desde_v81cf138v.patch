+def test_be_cr0_08_inventario_multi_pdf():
+    """BE-CR0-08 (CR desde cero 14-nov): en un set de varios PDF (A 86 + S 26 páginas) el inventario de tags del PDF de arquitectura (86) se
+    marcaba 'inventario de otro set' (86 != 112); ahora vale si sus páginas = las de UNO de los PDF fuente. Un número que no es de ningún
+    PDF sigue fallando."""
+    import chequeos_biblioteca as CB_
+    mk = lambda n: CB_.B(canon={"walls": [{"id": "W1", "element": "wall"}]}, set_meta={"fuentes": [{"paginas": 86}, {"paginas": 26}]},   # noqa: E731
+                         inv_full={"pages": n, "ocurrencias": {"partition_tag": [{"id": "P1", "type": "W.9", "sheet": "A9.01"}]}})
+    assert not [x for x in CB_.u_117(mk(86))[1] if "inventario de otro set" in x]
+    assert not [x for x in CB_.u_117(mk(112))[1] if "inventario de otro set" in x]
+    assert [x for x in CB_.u_117(mk(50))[1] if "inventario de otro set" in x]
+
+
+test_be_cr0_08_inventario_multi_pdf()
