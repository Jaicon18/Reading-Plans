+def test_be_cr0_05_06_alturas_lista_larga():
+    """BE-CR0-05 / 06 (CR desde cero 14-nov, test del proyecto test_be_cr0_06_07_08.py): con cientos de walls a la misma altura la lista llenaba la
+    página y la imagen iba a Rect(36, y+6, 756, 590) con y > 590 = 'rect must be finite and not empty' (CE_ALTURAS_EXTREMO se caía); ahora la
+    imagen va en una página de continuación y cada página creada lleva su Page Label (únicos, labels == páginas)."""
+    import tempfile
+    import pymupdf
+    import pypdf
+    d = tempfile.mkdtemp(prefix="becr005_")
+    img = os.path.join(d, "x.png")
+    pymupdf.Pixmap(pymupdf.csRGB, pymupdf.IRect(0, 0, 20, 20), 0).save(img)
+    final = [{"Printed H": "9'-3 1/2\"", "Wall ID": f"W.9-L9-{k:03d} {'A' * 40}", "Source": "x" * 400, "Operation": "", "Status": "DERIVED",
+              "Image": img} for k in range(600)]
+    out = os.path.join(d, "a.pdf")
+    CA.alturas_revisadas(final, d, out, None, {})
+    r = pypdf.PdfReader(out)
+    labs = [r.page_labels[i] for i in range(len(r.pages))]
+    assert len(set(labs)) == len(labs) == len(r.pages), labs
+    assert any("continued" in x for x in labs), labs
+
+
+if __name__ == "__main__":
