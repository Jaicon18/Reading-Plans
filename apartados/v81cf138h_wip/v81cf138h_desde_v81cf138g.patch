+    rev1d (HDR-101-NESTED 362S125-33) = PASS; una fila de TRACK que cite la puerta no cuenta como stud."""
+    import json as _j
+    import chequeos_biblioteca as CB_
+    can = {"walls": [{"id": "W", "openings": [{"ref": "Door 7", "pieces": 2, "piece": "track", "header": "5/A5 TRACK + NESTED STUD"}]}],
+           "misc_items": [{"ref": "HDR-7", "familia": "track header", "qty": 4.0, "source": "5/A5 door 7 | 362T125-33"}]}
+    assert CB_.head_piezas_fallas(can), "una fila de track no es la pieza de stud"
+    can["misc_items"].append({"ref": "HDR-7-S", "familia": "3-5/8\" stud", "qty": 4.0, "source": "5/A5 door 7 nested stud | 362S125-33"})
+    assert CB_.head_piezas_fallas(can) == []
+    D = None
+    for raiz in (os.environ.get("TAKEOFF_REPO"), "/home/user/Reading-Plans", os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")):
+        d = os.path.join(raiz or "", "cache_proyectos", "herramientas", "tests")
+        if raiz and os.path.isfile(os.path.join(d, "be_xf20_xf_rev1c.json")):
