+                if any(otro_material_ok(t) for t in textos) or any(gap_prueba_ok(t) for t in pruebas):   # gap 0 medido también prueba
+                    continue
+                motivo = ("is disposed / excluded without proof: same wall = gap_proof with gap measured 0 + N/SHEET; another printed "
+                          "material (CMU / masonry / concrete / existing / by others) = material + N/SHEET + gap measured > 0")
             ev.append(f"{w.get('id')}: parallel leaf {hid} ({est}) at {abs(cross - c_mid) / e_h * 12:.1f} in. from its band on "
-                      f"{b.get('sheet')} is excluded / disposed without a gap_proof (N/SHEET + measured gap): two leaves with a gap are two "
-                      "walls (BE-GK54, v121 structural)")
+                      f"{b.get('sheet')} {motivo} (BE-GK54)")
     return ev
 
 
