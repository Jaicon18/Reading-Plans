+            r["muros"] = len(trs)
+            for k, tr in enumerate(trs, 1):
+                lf = (tr["hi"] - tr["lo"]) / esc
+                x, y = _cob_xy(tr, 0.5)
+                f = tr["f"]
+                en_exc = any(_cob_dentro(P, x, y) for P in exc)
+                ident = f"M-{lab}-{k}"
