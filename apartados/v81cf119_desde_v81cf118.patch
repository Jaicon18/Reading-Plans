+def test_v119_be_cr40_verificacion():
+    """verificación independiente 12b (BE-CR40 STILL-WEAK): (1) 'faltante_por_tag: CARGADO' escrito en el renglón no es prueba — se llama
+    la función y lo cargado = FAIL; (2) hallazgo sin tag ('corridor 901 ceiling missing') se resuelve por cuarto: cargado = FAIL, sin
+    cielo = PASS; sin tag ni cuarto = FAIL (no N/A); (3) se lee cualquier .md de Auditoria/, no solo AUDITORIA / INFORME. Sintético."""
+    fn = CB.faltantes_auditoria
+    can = {"walls": [], "ceilings": [{"room": "Z9 Corridor 901", "area_sf": 50.0}],
+           "rcp_tags": [{"sheet": "X9.01", "tag": "GYP-9", "height": "8'-11\"", "rows": ["ceilings[0]"]}]}
+    t = lambda ln, nom="Auditoria/notas_rev9.md": {nom: "| 1 | " + ln + " | add |"}     # noqa: E731
+    e, ev = fn(B(canon=can, textos=t("X9.01 GYP-9 8'-11\" missing in corridor 901 — faltante_por_tag: FALTA")))
+    assert e == "FAIL" and "CARGADO" in ev[0], (e, ev)                    # (1) auto-declaración ignorada; (3) notas_rev9.md se lee
+    e, ev = fn(B(canon=can, textos=t("corridor 901 ceiling missing")))
+    assert e == "FAIL" and "901" in ev[0], (e, ev)                        # (2) por cuarto: cargado
+    e, ev = fn(B(canon=can, textos=t("corridor 902 ceiling missing")))
+    assert e == "PASS", (e, ev)                                           # cuarto sin cielo en el canon: falta de verdad
+    e, ev = fn(B(canon=can, textos=t("corridor ceiling missing")))
+    assert e == "FAIL" and "no se puede resolver" in ev[0], (e, ev)
+    can2 = dict(can, rcp_tags=can["rcp_tags"] + [{"sheet": "X9.02", "tag": "GYP-9", "height": "9'-0\"", "rows": []}])
+    e, ev = fn(B(canon=can2, textos=t("GYP-9 missing")))
+    assert e == "FAIL" and "no se puede resolver" in ev[0], (e, ev)       # tag ambiguo (una cargada, otra no) = FAIL
+    can3 = dict(can, misc_items=[{"ref": "CLG-Z9-901 board", "qty": 50.0}])                      # cierre con la ref que lo cargó
+    e, ev = fn(B(canon=can3, textos=t("corridor 901 ceiling missing", nom="Auditoria/AUDITORIA_U181_rev9.md") | {"x": ""}))
+    assert e == "FAIL", (e, ev)                                           # sin cierre en el renglón: cargado = FAIL
+    e, ev = fn(B(canon=can3, textos={"Auditoria/AUDITORIA_U181_rev9.md": "| 1 | corridor 901 ceiling missing | added CLG-Z9-901 |"}))
