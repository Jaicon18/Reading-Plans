+def _cob_pdf(doc, dib, res, out_pdf):
+    """una página por hoja: la hoja en gris claro, lo cubierto en verde tenue, lo ROJO grueso, circulado y numerado; IMAGE ONLY."""
+    import pymupdf
+    tmp = pymupdf.open()
+    tmp.insert_pdf(doc)
