+def be_gk54_fallas(canon, cob_rows, esc=9.0, gap_in=14.0, to_canon=None, escalas=None):
+    """BE-GK54 (Grand Kia rev3a, U-193 rojo M-A111-29, 12-nov; unido de apartados/be_gk54): dos bandas paralelas con gap (o con dos tags) son
+    DOS walls. Una exclusión 'same (single) wall as <X>' sin gap_proof da FAIL cuando el mapa de cobertura tiene una banda ROJA paralela a
+    la de X, en la misma hoja, a <= 14 in + el espesor de X y solapada con ella. to_canon(hoja, x, y): punto del CSV -> espacio de la banda
+    del canon (con el PDF: Point(x, y) * page.rotation_matrix)."""
+    to_canon = to_canon or (lambda h, x, y: (x, y))
+    walls = {w.get("id"): w for w in (canon or {}).get("walls") or [] if isinstance(w, dict)}
+    ev = []
+    for e in (canon or {}).get("excluded_walls") or []:
+        m = RX_GK54_SAME.search(str(e.get("reason") or ""))
+        if not m or str(e.get("gap_proof") or "").strip():
+            continue
+        b = (walls.get(m.group(1)) or {}).get("band") or {}
+        if b.get("ori") not in ("H", "V"):
+            continue
+        c_mid = (float(b["c0"]) + float(b["c1"])) / 2
+        lo, hi = sorted((float(b["lo"]), float(b["hi"])))
+        esc = float((escalas or {}).get(b.get("sheet")) or esc)          # escala de la hoja del mapa (pt / ft); GK A111 = 9
+        tol = (gap_in / 12.0) * esc + abs(float(b["c1"]) - float(b["c0"]))
+        for r in cob_rows:
+            if r.get("hoja") != b.get("sheet") or r.get("tipo") != "muro" or r.get("estado") != "ROJO":
+                continue
+            rx, ry = to_canon(r["hoja"], float(r["x"]), float(r["y"]))
+            L = float(r.get("largo_ft") or 0) * esc
+            along, cross = (rx, ry) if b["ori"] == "H" else (ry, rx)
+            if abs(cross - c_mid) <= tol and along + L / 2 >= lo - esc and along - L / 2 <= hi + esc and abs(cross - c_mid) > 0.5:
+                ev.append(f"{e.get('id')}: excluded as 'same wall as {m.group(1)}' but the coverage map has a separate parallel band "
+                          f"{r['id']} ({rx:.1f}, {ry:.1f}) {r.get('largo_ft')} ft at {abs(cross - c_mid) / esc * 12:.1f} in. from it, RED: two "
+                          "leaves with a gap are two walls (BE-GK54); prove the gap does not exist ('gap_proof' with N/SHEET) or carry it")
+    return ev
+
