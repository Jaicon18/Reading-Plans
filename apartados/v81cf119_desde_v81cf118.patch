+def _gk54_desde_pdf(pdf):
+    import pymupdf
+    d = pymupdf.open(pdf)
+    pg = {(d[i].get_label() or str(i + 1)): d[i] for i in range(len(d))}
+
+    def tc(h, x, y):
+        p = pg.get(h)
+        if p is None:
+            return x, y
+        q = pymupdf.Point(x, y) * p.rotation_matrix
+        return q.x, q.y
+    return tc
