+                dib[i].append(("muro", tr, est, k))
+        if es_rcp:
+            lineas = [(it[1].x, it[1].y, it[2].x, it[2].y) for dr in pg.get_drawings() for it in dr["items"] if it[0] == "l"
+                      and math.hypot(it[2].x - it[1].x, it[2].y - it[1].y) >= 1.0 * esc]
