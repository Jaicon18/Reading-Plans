+                             for k, i in enumerate(sorted(dib))])
+    except Exception:                                                   # noqa: BLE001
+        pass
+    os.makedirs(os.path.dirname(out_pdf) or ".", exist_ok=True)
+    out.save(out_pdf, deflate=True)
