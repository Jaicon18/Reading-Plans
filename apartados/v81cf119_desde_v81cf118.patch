+                if not (en_c or en_e):                          # tag fuera del cuarto con su línea guía: se sigue la guía
+                    pts = [p for p in _cob_lider(lineas, x, y, esc)
+                           if not any(_IndiceSegs([(P[q][0], P[q][1], P[(q + 1) % len(P)][0], P[(q + 1) % len(P)][1])
