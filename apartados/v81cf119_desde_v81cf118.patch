+        r = {"tipo": "RCP" if es_rcp and not es_planta else ("planta" if not es_rcp else "planta+RCP"), "escala_pt_ft": round(esc, 3),
+             "muros": 0, "muros_lf": 0.0, "cubierto_lf": 0.0, "rojos": 0, "cuartos": 0, "cuartos_ok": 0, "cuartos_exc": 0}
