+def test_v138r2_verif8_tiempos_desde_pruebas():
+    """v138 rev2 (verificación 8): una fila de TIEMPOS.md queda exenta (rev anterior) SOLO si cierra antes del arranque Y tiempos.log
+    tiene la marca de ese cierre antes del arranque; se quita la fila exacta, nunca otra que comparta la hora; sin marcas nada queda
+    exento."""
+    from zoneinfo import ZoneInfo
+    import datetime as _dt
+    tz = ZoneInfo("America/Los_Angeles")
+    tt = ("| # | Paso | Inicio | Fin | Min |\n|---|---|---|---|---|\n| 9 | Subida | 11-13 08:00 | 11-13 08:40 | 40 |\n"
+          "| 1 | Inventario | 11-13 08:40 | 11-13 09:30 | 50 |\n")
+    desde = _dt.datetime(2026, 11, 13, 8, 45, tzinfo=tz)
+    m = [(_dt.datetime(2026, 11, 13, 8, 40, tzinfo=tz), "9 fin"), (_dt.datetime(2026, 11, 13, 9, 30, tzinfo=tz), "1 fin")]
+    txt, n = CE.tiempos_desde(tt, desde, m)
+    assert n == 1 and "Inventario" in txt and "Subida" not in txt, (n, txt)
+    assert CE.tiempos_desde(tt, desde, []) == (tt, 0)
+    assert CE.tiempos_desde(tt, desde, m[1:])[1] == 0                 # el cierre del paso viejo sin marca: no se exime
+    tarde = _dt.datetime(2026, 11, 13, 13, 50, tzinfo=tz)
+    assert CE.tiempos_desde(tt, tarde, [(tarde, "inicio")])[1] == 0  # una sola marca tardía no exime la mañana
+    print("test_v138r2_verif8_tiempos_desde_pruebas OK")
+
+
+test_v138r2_verif8_tiempos_desde_pruebas()
+
