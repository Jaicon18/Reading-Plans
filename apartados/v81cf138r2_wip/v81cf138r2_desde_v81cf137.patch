+    """ISO con o sin zona (sin zona = UTC, como fijar_version_proyecto) -> datetime con zona o None."""
+    try:
+        t = datetime.datetime.fromisoformat(str(x).strip().replace("Z", "+00:00"))
+    except (TypeError, ValueError):
