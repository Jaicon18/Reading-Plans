+def test_v138_protocolo_rev_posterior_solo_sus_pasos():
+    """v138 (CR rev20c, COORDINACIÓN 08:25): una rev que arranca DESPUÉS de v119 en un tiempos.log acumulado ('inicio revN') solo se juzga
+    con los pasos que cierran desde su arranque: los pasos de la rev original (otro día) quedan exentos con la causa escrita; un paso de
+    la rev actual sin su corrida '--paso' sigue = FAIL; con la corrida = PASS."""
+    w = tempfile.mkdtemp(prefix="p3h_")
+    e = os.path.join(w, "rev9c FINAL PARA REVISAR")
+    os.makedirs(os.path.join(e, "Take-off"))
+    open(os.path.join(e, "Take-off", "Z9_Takeoff_rev9c.xlsx"), "w").write("x")
+    open(os.path.join(w, "tiempos.log"), "w").write("05-nov 11:26 PST | 0 Arranque | inicio\n05-nov 11:34 PST | 1 Inventario | inicio\n"
+                                                     "05-nov 12:10 PST | 1 Inventario | fin\n12-nov 20:46 PST | inicio rev9c\n"
+                                                     "12-nov 21:30 PST | 4 Lectura | fin\n")
+    open(os.path.join(w, "VERSION_PROYECTO.txt"), "w").write(f"2026-11-13T04:46:00Z | rev9c | {CE._skill_version() or 'v81cf138'}\n")
+    tt = ("| # | Paso | Inicio | Fin | Min |\n|---|---|---|---|---|\n| 1 | Inventario | 11-05 11:34 | 11-05 12:10 | x |\n"
+          "| 4 | Lectura | 11-12 20:50 | 11-12 21:30 | x |\n")
+    est, ev = CE.proceso_v119(w, e, tt, 10)
+    assert est == "FAIL" and any("paso 4" in x for x in ev) and not any("paso 1 " in x for x in ev), (est, ev)
+    open(os.path.join(w, "compuerta_corridas.jsonl"), "w").write(json.dumps({"paso": "4", "rc": 0}) + "\n")
+    CE.sellar_bitacora(w, os.path.join(w, "compuerta_corridas.jsonl"))
+    est, ev = CE.proceso_v119(w, e, tt, 10)
+    assert est == "PASS" and any("rev anterior" in x for x in ev), (est, ev)
+    # v138 (verificación 7, P1 / P2): la marca 'inicio revN' escrita TARDE no exime los pasos que la rev ya cerró: manda el arranque más
+    # temprano (VERSION_PROYECTO.txt fijado al arrancar). Pasos 1 y 2-3 de la misma rev sin '--paso' = FAIL.
+    filas = ("| # | Paso | Inicio | Fin | Min |\n|---|---|---|---|---|\n| 1 | Inventario | 11-13 08:00 | 11-13 08:30 | x |\n"
+             "| 2-3 | Lecturas | 11-13 08:30 | 11-13 09:30 | x |\n| 4 | Comparación | 11-13 10:00 | 11-13 10:30 | x |\n")
+    for acumulado in (False, True):
+        w0 = tempfile.mkdtemp(prefix="p3h_tarde_")
+        w = os.path.join(w0, "rev21") if acumulado else w0
+        e = os.path.join(w, "rev21 FINAL PARA REVISAR")
+        os.makedirs(os.path.join(e, "Take-off"))
+        open(os.path.join(e, "Take-off", "Z9_Takeoff_rev21.xlsx"), "w").write("x")
+        log = ("2026-11-13 10:00 | 4 inicio rev21\n2026-11-13 10:30 | 4 fin\n" if not acumulado else
+               "05-nov 11:26 PST | 0 Arranque rev20 | inicio\n05-nov 19:00 PST | rev20 entregada\n2026-11-13 08:00 | 1 inicio\n"
+               "2026-11-13 08:30 | 1 fin\n2026-11-13 09:30 | 2-3 fin\n2026-11-13 10:00 | inicio rev21\n2026-11-13 10:30 | 4 fin\n")
+        open(os.path.join(w0, "tiempos.log"), "w").write(log)
+        open(os.path.join(w, "VERSION_PROYECTO.txt"), "w").write(f"2026-11-13T16:00:00+00:00 | rev21 | {CE._skill_version() or 'v81cf138'}\n")
+        open(os.path.join(w, "compuerta_corridas.jsonl"), "w").write(json.dumps({"paso": "4", "rc": 0}) + "\n")
+        CE.sellar_bitacora(w, os.path.join(w, "compuerta_corridas.jsonl"))
+        est, ev = CE.proceso_v119(w, e, filas, 5)
+        assert est == "FAIL" and any("paso 1 " in x for x in ev) and any("paso 2-3" in x for x in ev), (acumulado, est, ev)
