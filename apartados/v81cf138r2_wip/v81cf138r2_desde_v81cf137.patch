+    assert "0 walls" not in json.dumps(ev)
+    # v138: un wall de madera CON framing en walls[] escrito '2 X 6' / 'DF stud' / 'timber' / 'Douglas fir' / 'SPF' = FAIL
+    for ss, ga in (("2 X 6", "DF-L #2"), ("5-1/2 DF stud", "lumber"), ("6 timber stud", "n/a"), ("2×6", "SPF"), ("2 x 4", "Douglas fir")):
+        b = B()
