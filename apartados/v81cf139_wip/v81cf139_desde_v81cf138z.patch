+def test_be_cr0_12_stack_largo_por_cara():
+    """BE-CR0-12 (CR desde cero 14-nov): _walls_board_only agrupa las entradas de un wall (caras A..Z) y be_cr27_stack multiplicaba TODAS
+    las caras por el length_ft de la primera entrada: un piso típico con caras de largo distinto salía inflado / desinflado contra la
+    mediana (FAIL falso). Ahora cada cara lleva SU length_ft."""
+    def ex(n, la, lb):
+        return [{"id": f"X9-L{n}-01 A", "sheet": f"X{n}.1", "length_ft": la, "height_ft": 10.0, "board": "5/8 type X", "layers": 1,
+                 "location": f"faces: ROOM {n}91", "type_id": "Z9-01", "decision": "wood framed, board only"},
+                {"id": f"X9-L{n}-01 B", "sheet": f"X{n}.1", "length_ft": lb, "height_ft": 10.0, "board": "5/8 type X", "layers": 1,
+                 "location": f"faces: ROOM {n}92", "type_id": "Z9-01", "decision": "wood framed, board only"}]
+    can = {"walls": [], "wood_excluded": True, "typical_floors": ["L7", "L8", "L9"],
+           "existing_walls": ex(7, 10.0, 10.0) + ex(8, 10.0, 10.0) + ex(9, 2.0, 18.0)}
+    b = B(canon=can)
+    caras = {f["entry"]: f.get("length_ft") for w in b._walls_board_only() for f in w["faces"]}
+    assert caras["X9-L9-01 A"] == 2.0 and caras["X9-L9-01 B"] == 18.0, caras
+    r = CB.be_cr27_stack(b)
+    assert r[0] == "PASS", r
+    malo = copy.deepcopy(can); malo["existing_walls"][-1]["length_ft"] = 30.0     # L9 de verdad más cargado: sigue FAIL
+    assert CB.be_cr27_stack(B(canon=malo))[0] == "FAIL"
+    print("test_be_cr0_12_stack_largo_por_cara OK")
+
+
+test_be_cr0_12_stack_largo_por_cara()
