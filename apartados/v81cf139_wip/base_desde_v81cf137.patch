+def test_v138_cob_diag_familias_cr():
+    """v138 (CR rev20c, familias de falsos de CE_COBERTURA_DIAG decididas por 7 revisores): (1) el divisor de la caja del tag de muro
+    con palabras pegadas a los dos lados no es muro; (5) / (8) un par discontinuo (grid lines, leaders, límites de vista) no es muro;
+    (4) / (10) un par dentro de un hatch denso de líneas cortas no es muro; un stub real que remata en un muro sigue saliendo."""
+    esc = 18.0
+    doc = pymupdf.open()
+    pg = doc.new_page(width=1600, height=1000)
+
+    def par(x0, y0, x1, y1, dx, dy, dashes=None):
+        sh = pg.new_shape()
+        sh.draw_line((x0, y0), (x1, y1))
+        sh.draw_line((x0 + dx, y0 + dy), (x1 + dx, y1 + dy))
+        sh.finish(color=(0, 0, 0), width=0.7, dashes=dashes)
+        sh.commit()
+    par(100, 400, 1580, 400, 0, 9)                                  # muro largo H
+    par(300, 409, 300, 409 + 1.5 * esc, 9, 0)                      # stub real (debe salir)
+    par(600, 409, 600, 409 + 1.5 * esc, 9, 0)                      # (1) divisor de tag: palabras a los dos lados
+    pg.insert_text((582, 425), "Z9.1", fontsize=9)
+    pg.insert_text((612, 425), "0", fontsize=9)
+    par(900, 409, 900, 409 + 1.5 * esc, 9, 0, dashes="[3 2] 0")    # (5) discontinuo
+    par(1200, 409, 1200, 409 + 1.5 * esc, 9, 0)                    # (4) dentro de un hatch denso
+    sh = pg.new_shape()
+    for k in range(60):
+        sh.draw_line((1140 + k * 2.0, 412), (1140 + k * 2.0, 432))
+    sh.finish(color=(0.4, 0.4, 0.4), width=0.2)
+    sh.commit()
+    par(1400, 409, 1400, 409 + 1.5 * esc, 9, 0)                    # (10) dentro del cross-hatch de un CMU
+    sh = pg.new_shape()
+    for k in range(6):
+        sh.draw_line((1390 + k * 4, 412), (1400 + k * 4, 422))
+        sh.draw_line((1400 + k * 4, 412), (1390 + k * 4, 422))
+    sh.finish(color=(0.1, 0.1, 0.1), width=0.24)
+    sh.commit()
+    par(1500, 409, 1500, 409 + 1.5 * esc, 9, 0)                    # furring real pegado a un CMU: el hatch queda de UN solo lado
+    sh = pg.new_shape()
