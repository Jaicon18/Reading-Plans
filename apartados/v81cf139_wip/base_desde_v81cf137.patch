+def test_v138_reemplazo_corrida_sin_agente():
+    """v138 (verificación 6, adv6_u193, U-193, sintético): una corrida sin agente solo queda REEMPLAZADA si la corrida con agente la
+    rehace (corrida_reemplaza: rc 0, con resultado, mismos args, mismos hashes, sin --help); una corrida trivial ('--help', rc distinto
+    de 0) de la misma tool un minuto después NO la reemplaza = FAIL; ids 'revisor A1' y 'A1 (canon)' = 'A1'."""
+    import bitacora as BT
+
+    def bit(rows):
+        w = tempfile.mkdtemp(prefix="v138u193_")
+        with open(os.path.join(w, "bitacora.jsonl"), "w") as f:
+            for tool, ag, args, rc, ts, hs in rows:
+                r = {"tool": tool, "args": args, "rc": rc, "hashes": hs, "log": "x", "ts": ts}
+                if ag:
+                    r["agente"] = ag
+                f.write(json.dumps(r) + "\n")
+        return w
+
+    def juzgar(w):
+        _rev, _aut, _can, sin = CE.subagentes_bitacora(w)
+        _viejas, nuevas = CE.corridas_sin_agente_por_fecha(sin)
+        return CE.sin_agente_reemplazadas(nuevas, CE.corridas_con_agente(w), CE.corridas_sin_agente_filas(w))
+    h = {"markups.json": "h1"}
+    base = [("canon.py", "A1", [], 0, "2026-11-13T09:00:00", {}), ("markups_bluebeam.py", None, ["markups.json"], 0, "2026-11-13T09:30:00", h)]
+    rep, no = juzgar(bit(base + [("markups_bluebeam.py", "A1", ["--help"], 2, "2026-11-13T09:31:00", {})]))
+    assert not rep and no, (rep, no)                                     # V7: corrida trivial no reemplaza
+    rep, no = juzgar(bit(base + [("markups_bluebeam.py", "A1", ["markups.json"], 2, "2026-11-13T09:31:00", h)]))
+    assert not rep and no, (rep, no)                                     # rc distinto de 0 no reemplaza
+    rep, no = juzgar(bit(base + [("markups_bluebeam.py", "A1", ["markups.json"], 0, "2026-11-13T09:31:00", {"markups.json": "h2"})]))
+    assert not rep and no, (rep, no)                                     # otros hashes = no rehízo la misma corrida
+    rep, no = juzgar(bit(base + [("markups_bluebeam.py", "A1", ["markups.json"], 0, "2026-11-13T09:31:00", h)]))
+    assert rep and not no, (rep, no)                                     # control: misma corrida rehecha con agente = reemplazada
+    assert CE.sin_agente_reemplazadas(["x.py 2026-11-13T09:30:00"], [("x.py", "2026-11-13T09:31:00")]) == ([], ["x.py 2026-11-13T09:30:00"])
+    for a_, b_ in (("revisor A1", "A1"), ("A1 (canon)", "A1"), ("reviewer R9", "subagente R9")):
+        assert CE.norm_agente(a_) == CE.norm_agente(b_), (a_, b_)        # V4e / V4f
+    assert CE.norm_agente("revisor A1") != CE.norm_agente("R9") and BT is not None
+    print("test_v138_reemplazo_corrida_sin_agente OK")
+
+
+test_v138_reemplazo_corrida_sin_agente()
