+    assert ev and "measures a gap" in ev[0], ev                          # exclusión del canon con band lejos y 'gap 0' = FAIL
+    assert abs(CE.gap_medido_in(10.0, 0.0, 1.0, 1.0, 9.0) - 10.67) < 0.01
+    print("test_v138_gk54_gap_medido OK")
