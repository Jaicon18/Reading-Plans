+def solo_rev_actual(textos, carpeta=None):
+    """v138 (BE-CR40 S3): de los archivos de hallazgos con la rev en el NOMBRE (BITACORA_rev20.md, RESUMEN_rev19.md, REVIEW_rev9.md) quedan
