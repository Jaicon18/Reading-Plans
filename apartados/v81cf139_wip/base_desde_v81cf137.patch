+def test_v138_alarma_plazo_tiempos():
+    """v138 (verificación 6, adv6_pm06, NG-3.3 / BE-PM06, sintético): el plazo de la alerta de presupuesto sale también de la hora de Fin
+    de TIEMPOS.md (cierres_pasos), no solo del texto '| N fin' del log: con el log en palabras ('inventario cerrado') o en español
+    ('| 4 terminado') UNA sola alerta escrita al final (ya pasado el 100 %) = FAIL; alertas escritas en vivo al cerrar cada paso = PASS;
+    sin TIEMPOS.md ni 'N fin', cada marca del log cuenta como cierre."""
+    TT = ("| Paso | Inicio (PST) | Fin (PST) | Duración |\n|---|---|---|---|\n"
+          "| 1 | 11-13 09:00 | 11-13 09:40 | 40 min |\n| 2-3 | 11-13 09:40 | 11-13 11:00 | 80 min |\n"
+          "| 4 | 11-13 11:00 | 11-13 12:20 | 80 min |\n| 5 | 11-13 12:20 | 11-13 13:00 | 40 min |\n| TOTAL | | | 240 min |\n")
+    REG = [{"evento": "fin", "paso": p} for p in ("1", "2-3", "4", "5")]
+
+    def caso(log, al_final=True, en_vivo=False, tt=TT):
+        w = tempfile.mkdtemp(prefix="v138pm06_")
+        lns = log.strip().splitlines()
+        if en_vivo:
+            for k in range(1, len(lns) + 1):
+                open(os.path.join(w, "tiempos.log"), "w").write("\n".join(lns[:k]) + "\n")
+                CE.alerta_presupuesto(w, 5)
+        open(os.path.join(w, "tiempos.log"), "w").write(log)
+        if al_final:
+            CE.alerta_presupuesto(w, 5)
+        return CE.alarma_fallas(w, 5, registro=REG, tiempos_txt=tt)
+    FIN = "2026-11-13 09:00 | 1 inicio\n2026-11-13 09:40 | 1 fin\n2026-11-13 11:00 | 2-3 fin\n2026-11-13 12:20 | 4 fin\n2026-11-13 13:00 | 5 fin\n"
+    TXT = ("2026-11-13 09:00 | inicio inventario\n2026-11-13 09:40 | inventario cerrado\n2026-11-13 11:00 | lecturas A/B cerradas\n"
+           "2026-11-13 12:20 | comparación cerrada\n2026-11-13 13:00 | markups cerrados\n")
+    ES = FIN.replace(" fin", " terminado")
+    assert caso(FIN, False, True) == []                                  # control en vivo
+    for k, log in (("N1", FIN), ("N2", TXT), ("N3", ES)):
+        ev = caso(log)
+        assert any("50 %" in x for x in ev) and any("100 %" in x for x in ev), (k, ev)   # una alerta al final no cubre el cruce
+    assert caso(TXT, False, True) == [] and caso(ES, False, True) == []  # en vivo con el log en palabras / en español = PASS
+    ev = caso(TXT, tt=None)
+    assert any("50 %" in x for x in ev), ev                              # sin TIEMPOS.md: cada marca del log es un cierre
+    print("test_v138_alarma_plazo_tiempos OK")
