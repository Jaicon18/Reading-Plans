+def test_v138r2_verif8_caras_lista_como_v137():
+    """v138 rev2 (verificación 8): una LISTA de caras se juzga exactamente como v137 (solo full height / to deck / above ceiling
+    justifican): una palabra suelta de otro elemento en la fuente no calla la cara; un muro SIN faces no se juzga (como v137); faces =
+    número sigue sin crash y con su cara."""
+    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "runner"))
+    import completitud as CO
+
+    def can(faces=None, **w):
+        b = {"id": "Z9-W1", "location": "L9 | 905 GUEST", "height_ft": 11.0}
+        b.update(w)
+        if faces is not None:
+            b["faces"] = faces
+        return {"ceilings": [{"room": "905 GUEST", "height_ft": 9.0}], "walls": [b]}
+    F = lambda s: [{"room": "905 GUEST", "height_ft": 11.0, "height_source": s}]   # noqa: E731
+    for s in ("C-2 GWB ceiling hung from underside of floor joists above", "11'-0\" per 3/A3.1; see stair enclosure detail",
+              "level floor to floor 11'-0\" used as wall height", "11'-0\"; duct shaft extends to structure (M2.1)"):
+        assert CO.caras_sobre_ceiling(can(F(s))), s
+    assert CO.caras_sobre_ceiling(can(F("full height to deck"))) == []
+    assert CO.caras_sobre_ceiling(can(None, location="pier of 905 GUEST", height_source="A3.1 11'-0\"")) == []
+    assert CO.caras_sobre_ceiling(can({"905 GUEST": 11.0}, height_source="A3.1")) == []
+    assert CO.caras_sobre_ceiling(can(2, height_source="A3.1 11'-0\""))
+    assert CO.caras_sobre_ceiling(can(1, location="L9 905 GUEST | faces: exterior", height_source="A3.1")) == []
+    print("test_v138r2_verif8_caras_lista_como_v137 OK")
+
+
+test_v138r2_verif8_caras_lista_como_v137()
