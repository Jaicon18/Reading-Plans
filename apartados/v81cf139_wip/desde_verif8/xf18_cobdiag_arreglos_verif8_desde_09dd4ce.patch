+def test_v138r2_verif8_markups_rev():
+    """v138 rev2 (verificación 8): el PDF de markups de OTRA rev nunca se lee en silencio. Un solo 'OPEN IN BLUEBEAM' de la rev anterior
+    con el markups de la rev en curso al lado = se lee el de la rev en curso; sin el de la rev en curso = FAIL con causa; la rev en curso
+    es la MÁS ALTA de los Excel, no la del Excel re-guardado más nuevo; un 'flattened' no gana al markups; 'COBERTURA' en el nombre de
+    un OPEN IN BLUEBEAM no lo descarta; 'IMAGE-ONLY' con guion es el mapa."""
+    import time
+
+    def caso(pdfs, xls):
+        w = tempfile.mkdtemp(prefix="xf18r2_")
+        pm, tk = os.path.join(w, "Planos marcados"), os.path.join(w, "Take-off")
+        os.makedirs(pm)
+        os.makedirs(tk)
+        t0 = time.time() - 1000
+        for k, n in enumerate(pdfs):
+            open(os.path.join(pm, n), "w").write("%PDF-1.4\n")
+        for k, n in enumerate(xls):
+            p = os.path.join(tk, n)
+            open(p, "w").write("x")
+            os.utime(p, (t0 + k, t0 + k))
+        r, causa = CE.elegir_pdf_markups(w)
+        return os.path.basename(r) if r else None, causa
+    ob_b, ob_c = "Z9_markups_rev20b - OPEN IN BLUEBEAM.pdf", "Z9_markups_rev20c - OPEN IN BLUEBEAM.pdf"
+    assert caso([ob_b, "Z9_markups_rev20c.pdf"], ["Z9_Takeoff_rev20c.xlsx"])[0] == "Z9_markups_rev20c.pdf"
+    r, causa = caso([ob_b], ["Z9_Takeoff_rev20c.xlsx"])
+    assert r is None and "OTRA rev" in causa, (r, causa)
+    assert caso([ob_b, ob_c], ["Z9_Takeoff_rev20c.xlsx", "Z9_Takeoff_rev20b.xlsx"])[0] == ob_c   # el rev20b re-guardado es el más nuevo
+    assert caso([ob_b, ob_c], ["Z9_Takeoff_rev20c.xlsx"])[0] == ob_c
+    assert caso(["Z9_markups_rev20c.pdf", "Z9_markups_rev20c_flattened.pdf"], ["Z9_Takeoff_rev20c.xlsx"])[0] == "Z9_markups_rev20c.pdf"
+    assert caso(["Z9_MAPA - IMAGE-ONLY.pdf", "Z9_markups_rev20c.pdf"], ["Z9_Takeoff_rev20c.xlsx"])[0] == "Z9_markups_rev20c.pdf"
+    fix = "Z9_markups_rev20c_COBERTURA-FIX - OPEN IN BLUEBEAM.pdf"
+    assert caso([fix, "MAPA DE COBERTURA - IMAGE ONLY.pdf"], ["Z9_Takeoff_rev20c.xlsx"])[0] == fix
+    assert caso([ob_c, "MAPA DE COBERTURA - IMAGE ONLY.pdf"], [])[0] == ob_c                      # sin Excel: el único OPEN
+    print("test_v138r2_verif8_markups_rev OK")
+
+
+test_v138r2_verif8_markups_rev()
