+        w.writerow(["201 Guest Room Type 1 - Room", "9.2396", "4/A5.05", ""])
+    cu = CA.alias_cuartos(dict(CA.leer_cuartos(p)))
+    can = {"existing_walls": [{"id": "UNTYPED-L2-08", "height_ft": 9.0, "location": "L2 bath 201 furring | faces: bath 201", "type_id": "FW.4-0"},
