+    cielo' de la habitación. Ahora el baño es su propio espacio ('201-bath'); sin fila propia del baño, toma la de la unidad (alias)."""
+    import tempfile, csv as _csv
+    assert CA.sala("201 Guest Room Type 1 - Bath") == "201-bath" == CA.sala("bath 201") == CA.sala("shower 201") == CA.sala("TOILET 201")
+    assert CA.sala("201 Guest Room Type 1 - Room") == "201" == CA.sala("guest room 201") and CA.sala("corridor south of toilet 111") == "111"
+    d = tempfile.mkdtemp(prefix="becr47_")
