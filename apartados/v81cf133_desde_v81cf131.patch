+        return [f"falta '{LEEME_NOMBRE}' en la raíz de la entrega (U-196: compuerta_entrega.py leeme <carpeta de entrega>)"]
+    txt = open(p, encoding="utf-8", errors="ignore").read()
+    citados = re.findall(r"(?m)^\s*-\s*`([^`]+)`", txt)
