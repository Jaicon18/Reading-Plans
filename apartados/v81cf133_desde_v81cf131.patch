+          "Una línea por archivo, en el orden en que se revisa: QUÉ ES · PARA QUÉ SIRVE · CUÁNDO ABRIRLO (U-196).", ""]
+    for rel in items:
+        _k, d = _leeme_patron(rel)
+        if d:
+            ls.append(f"- `{rel}` — **QUÉ ES:** {d[0]} · **PARA QUÉ SIRVE:** {d[1]} · **CUÁNDO ABRIRLO:** {d[2]}")
+        else:
