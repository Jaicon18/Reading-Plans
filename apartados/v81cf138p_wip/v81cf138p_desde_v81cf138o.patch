+    if not coincide_tag(esperado, txt):                             # BE-CR0-01: la MISMA normalización a los dos lados
         return False, f"texto bajo la marca '{txt.strip()}' ≠ '{esperado}'"
     return True, "ok"
 
 
+def _norm_i1(s):
+    """BE-GK03: '1' leído 'l' / 'I' / '|' por OCR detrás de una letra (F1.2 -> FI.2)."""
+    return re.sub(r"\b([A-Z])[lI|i]\b", r"\g<1>1", str(s or ""))
+
+
+def coincide_tag(esperado, txt):
+    """BE-CR0-01 (CR desde cero 13-nov): el tag esperado está en el texto bajo la marca, con la MISMA normalización I -> 1 a los dos lados
+    (antes solo al texto leído: FI.2 / FI.6 / XI.2.7 salían 'PNG NO VERIFICADO' y el inventario daba rc 1)."""
+    t, e = _norm_i1(txt), _norm_i1(esperado)
+    sin = re.sub(r"\s+", "", t)
+    return any(x in t or x in sin for x in (esperado, e))
+
+
 def overview(doc, hojas, occ, out_dir, dpi=60):
