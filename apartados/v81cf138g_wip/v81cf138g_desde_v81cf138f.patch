+    base = {"walls": [{"id": "W2-01", "type_id": "W2", "stud_size": "362S125-33"}],
+            "misc_items": [{"ref": "Z", "qty": 100.0, "unit": "LF", "source": "8/A2.0 zone on W2-01 | 362S162-54"},
+                           {"ref": "D", "qty": -60.0, "unit": "LF", "source": "8/A2.0 deduction 362S125-33"}]}
+    assert CB_.stud_zona_fallas(base) and "vs deduction" in CB_.stud_zona_fallas(base)[0]
+    base["misc_items"][0]["decision"] = "added on top: 8/A2.0 note 'IN ADDITION TO WALL STUDS'"
+    assert CB_.stud_zona_fallas(base) == []
