+    grid = {"walls": [{"id": "Z9-01", "type_id": "A", "stud_size": "362S125-33"}],   # verificación g #1 (Grand Kia): eje 'A' no es el type A
+            "misc_items": [{"ref": "Z", "qty": 10.0, "source": "ceiling framing at grid line A (H.1 to B) | 362S162-43"}]}
+    assert CB_.stud_zona_fallas(grid) == []
