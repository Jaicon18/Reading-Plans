+def _cara_de_muro(w):
+    """v138 (CR): muro con 'faces' = número -> una cara con la altura y la fuente del muro y el cuarto del location. Las caras del
+    location ('faces: exterior; <cuarto>') que son exteriores se quitan; si la ÚNICA cara es exterior, el muro no tiene cara bajo
+    un cielo (-> []). La cara interior de un muro exterior se juzga igual que cualquier otra."""
+    loc = str(w.get("location") or "")
+    m = re.search(r"(?i)faces?\s*:\s*(.*)$", loc)
+    if m:
+        partes = [x.strip() for x in re.split(r"[;,/]", m.group(1)) if x.strip()]
