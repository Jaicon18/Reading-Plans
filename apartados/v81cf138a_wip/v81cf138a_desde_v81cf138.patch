+def test_v1381_excepcion_usuario_subida():
+    """v81cf138.1 / U-201 (6): una compuerta con UN FAIL de proceso se sube solo con la excepción del usuario (ENTREGA_OK 'excepcion_usuario'
+    {check, texto, fecha, autorizado_por usuario} + README_REVIEW) y si ese es el ÚNICO FAIL; otro FAIL de más, otra check nombrada o sin
+    excepción = se niega como antes; 'ok' no se toca y SUBIDA_OK registra la excepción."""
+    w = workdir()
+    e = os.path.join(w, "FINAL_FOR_REVIEW")
+    TXT = "user authorized upload: process-only failure of a previous rev, no effect on quantities"
+    open(os.path.join(e, "README_REVIEW.md"), "a").write(f"\n## Process exception (U-201 (6))\nCE_PROTOCOLO_3H: {TXT}\n")
+
+    def ok_con(fails, ex):
+        c = CE.Ctx(w)
+        arch = {os.path.relpath(p, w): CE._sha(p) for p in c.archivos_entrega()}
+        ch = [{"id": "CE_X", "estado": "PASS", "evidencia": ["ok"]}] + [{"id": f, "estado": "FAIL", "evidencia": [f"{f}: falla"]} for f in fails]
+        d = {"ok": False, "entrega_dir": "FINAL_FOR_REVIEW", "chequeos": ch, "archivos": arch,
+             "drive": {"parent_id": CE.DRIVE_RAIZ, "carpeta_proyecto": "Proyecto X", "carpeta_proyecto_id": "FOLDER123"}}
+        if ex is not None:
+            d["excepcion_usuario"] = ex
+        json.dump(d, open(os.path.join(w, "ENTREGA_OK.json"), "w"))
+    EX = {"check": "CE_PROTOCOLO_3H", "texto": TXT, "fecha": "2026-11-13", "autorizado_por": "usuario"}
+    # (1) único FAIL = el chequeo nombrado + excepción -> pasa los candados y sube; SUBIDA_OK registra la excepción
+    ok_con(["CE_PROTOCOLO_3H"], EX)
+    SE.candados(w)
+    gd, log = fake_gdrive(["FOLDER123"])
+    r = subprocess.run([sys.executable, "-I", os.path.join(CE.AQUI, "subir_entrega.py"), w], capture_output=True, text=True,
+                       env=dict(os.environ, GDRIVE_FETCH=gd))
+    assert r.returncode == 0, r.stdout + r.stderr
+    sub = json.load(open(os.path.join(w, "SUBIDA_OK.json")))
+    assert sub.get("excepcion_usuario", {}).get("check") == "CE_PROTOCOLO_3H", sub
+    assert json.load(open(os.path.join(w, "ENTREGA_OK.json")))["ok"] is False          # 'ok' no se toca
+    for fails, ex, msg in ((["CE_PROTOCOLO_3H", "CE_Y"], EX, "ÚNICO FAIL"),                                   # (2) otro FAIL de más
+                           (["CE_PROTOCOLO_3H"], dict(EX, check="CE_OTRO"), "ÚNICO FAIL"),                   # (3) nombra otra check
+                           (["CE_PROTOCOLO_3H"], None, "sin excepcion_usuario"),                              # (4) sin excepción
+                           (["CE_PROTOCOLO_3H"], dict(EX, autorizado_por="coordinacion"), "no autorizada"),
+                           (["CE_PROTOCOLO_3H"], dict(EX, evidencia=["otra"]), "evidencia"),
+                           ([], EX, "corrida parcial")):
+        ok_con(fails, ex)
+        try:
+            SE.candados(w)
+            raise AssertionError(f"subió: {fails} {ex}")
+        except SE.Bloqueo as b:
+            assert "verde" in str(b) and msg in str(b), (msg, str(b))
+    # sin la excepción escrita en README_REVIEW = se niega
+    open(os.path.join(e, "README_REVIEW.md"), "w").write("# PROJECT DATA\nHoras en PST.\n")
+    ok_con(["CE_PROTOCOLO_3H"], EX)
+    try:
+        SE.candados(w)
+        raise AssertionError("subió sin la excepción en README_REVIEW")
+    except SE.Bloqueo as b:
+        assert "README_REVIEW" in str(b), str(b)
