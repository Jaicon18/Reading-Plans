+def test_u201_decisiones_regla():
+    """U-201 (usuario 13-nov, CR, botones 'A'): caso real CR (fixture de CR, commit 474c2f8): rev20c con RFI-32 (rating code plan vs tag),
+    RFI-33 (elementos sin tag) y RFI-34 (wrap con solo SFRM) ABIERTOS = 3 fallas; rev20d (cerrados por la regla, DA-7 / DA-8 con delta) = 0;
+    (1) cerrado SIN su DEDUCT = FAIL."""
+    import json as _j
+    import chequeos_biblioteca as CB_
+    D = None
+    for raiz in (os.environ.get("TAKEOFF_REPO"), "/home/user/Reading-Plans", os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")):
+        d = os.path.join(raiz or "", "cache_proyectos", "herramientas", "tests")
+        if raiz and os.path.isfile(os.path.join(d, "u201_cr_rev20c_rev20d.json")):
+            D = d
+            break
+    sint = {"rfis": [{"id": "RFI-1", "status": "closed", "question": "code plan 2 HR vs plan tag 1 HR"}], "deduct_alternates": []}
+    assert CB_.u201_fallas(sint) and "DEDUCT" in CB_.u201_fallas(sint)[0]
+    rx = {n: rx for n, (_d, rx) in CB_.U201_TEMAS.items()}                 # verificación k: redacciones y falsos positivos
+    for s in ("Wall type not shown at the niche", "No partition type indicated for the chase walls", "the east wall is not tagged"):
+        assert rx[2].search(s), s
+    for s in ("1 HR vs 2 HR fire rating discrepancy", "Life safety plan shows 2 HR but partition tag shows 1 HR"):
+        assert rx[1].search(s), s
+    assert rx[3].search("spray-applied fireproofing at the beam vs gypsum enclosure")
+    for s in ("SFRM is by others - confirm fireproofing excluded", "Room tag 904 on code plan differs from the finish plan", "Untagged ceiling: ACT or GWB?"):
+        assert not any(r.search(s) for r in rx.values()), s
+    assert CB_.u201_fallas({"rfis": [{"id": "R1", "status": "closed - code", "question": "the east wall is not tagged"}]}) == []
+    assert CB_.u201_fallas({"rfis": [{"id": "R1", "status": "closed", "question": "rating conflict, code plan 2 HR"}],
+                            "deduct_alternates": [{"rfi": "R1", "delta_sf": "-448.89 SF"}]}) == []
+    if not D:
+        print("AVISO test_u201_decisiones_regla: datos de CR no encontrados; caso real saltado")
+        return
+    fx = _j.load(open(os.path.join(D, "u201_cr_rev20c_rev20d.json")))
+    f = CB_.u201_fallas(fx["rev20c"])
+    assert sorted(x.split(":")[0] for x in f) == ["RFI-32", "RFI-33", "RFI-34"], f
+    assert CB_.u201_fallas(fx["rev20d"]) == []
+    sin_da = _j.loads(_j.dumps(fx["rev20d"]))
+    sin_da["deduct_alternates"] = [x for x in sin_da["deduct_alternates"] if x.get("rfi") != "RFI-32"]
+    assert [x for x in CB_.u201_fallas(sin_da) if x.startswith("RFI-32")]
+
+
