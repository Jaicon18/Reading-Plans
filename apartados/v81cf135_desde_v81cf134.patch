+    cielo = {m.group(1) for c in (canon or {}).get("ceilings") or [] for m in RX_CUARTO_NUM.finditer(str(c.get("room") or ""))}
+    muro = set().union(*[_cuartos_de(w) for w in muros_canon(canon or {}) if isinstance(w, dict)] or [set()])
