+    | 'both'}]) tiene board cargado: un cielo (ceilings.room) o una cara de muro de ese cuarto."""
+    hay = any(re.search(r"(?i)\b(?:ROOM\s+)?FINISH\s+SCHEDULE\b", str(t)) for h, t in (set_hojas or {}).items() if re.match(r"(?i)^[AI]\d", str(h)))
