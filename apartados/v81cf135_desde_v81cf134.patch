+    (canon.u199.rooms) tiene sus muros contados rated (>= 1 HR). -> (fallas, n)"""
+    walls = [w for w in muros_canon(canon or {}) if isinstance(w, dict)]
+    ev, n = [], 0
+    for ln in _u199(canon).get("rated_lines") or []:
