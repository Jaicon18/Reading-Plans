+def _rating(w):
+    for k in ("rating_hr", "rating", "fire_rating"):
+        try:
+            if w.get(k) not in (None, ""):
+                return float(re.sub(r"[^\d.]", "", str(w.get(k))) or 0)
+        except ValueError:
+            pass
+    m = re.search(r"-(\d)(?:\b|$)", str(w.get("type_id") or w.get("tag") or ""))
+    return float(m.group(1)) if m else 0.0
