+           "rcp_tags": [{"sheet": "X9.01", "tag": "GYP-9", "height": "8'-11\"", "rows": ["ceilings[0]"]}]}
+    A = "Auditoria/AUDITORIA_U181_rev9.md"
+
+    def run(ln, c=can, k=A, x=None):
+        return CB.faltantes_auditoria(CB.B(canon=c, textos=dict({k: "| 1 | " + ln + " | OPEN |"}, **(x or {}))))
+    for ln in ("corridor 905 ceiling not found in take-off", "corridor 905 ceiling not counted", "corridor 905 ceiling absent from estimate",
+               "corridor 905: ceiling GYP-9 is not in the Excel", "no se cargó el cielo del corredor 905", "corredor 905 sin cielo en el take-off",
+               "corridor 905 ceiling was left out", "corridor 905 ceilng missing", "Cuarto 905: falta el techo de tablaroca",
+               "Room 905 hard lid missing", "Room 905 drywall lid not loaded", "Room 905 bulkhead missing (7/X9.23)"):
+        e, ev = run(ln)
+        assert e == "FAIL" and "CARGADO" in ev[0], (ln, e, ev)          # S1 / S6
+    can2 = {"walls": [], "ceilings": [{"room": "Corridor C-12", "area_sf": 50.0}, {"room": "Room B12", "area_sf": 40.0}], "rcp_tags": []}
+    for ln in ("Corridor C-12 ceiling missing", "Room B12 ceiling missing"):
+        e, ev = run(ln, can2)
+        assert e == "FAIL" and "CARGADO" in ev[0], (ln, e, ev)          # S2 cuarto alfanumérico
+    assert run("Corridor C-19 ceiling missing", can2)[0] == "PASS"       # control: C-19 no está en el canon = falta de verdad
+    for k in ("COORDINACION/hallazgos_rev9.md", "REVIEW_rev9.md", "Auditoria/hallazgos.csv", "BITACORA.md", "RESUMEN_rev9.md"):
+        e, ev = run("corridor 905 ceiling missing", k=k)
+        assert e == "FAIL", (k, e, ev)                                  # S3 archivos fuera de Auditoria/*.md
+    e, ev = CB.faltantes_auditoria(CB.B(canon=can, textos_hallazgos={"COORDINACION/notas.md": "corridor 905 ceiling missing\n"}))
+    assert e == "FAIL", (e, ev)                                         # S3 los que carga desde_ctx aparte (textos_hallazgos)
+    e, ev = run("corridor 916 ceiling missing | CERRADO: EXT-Z9-2 (1/X9.31)")
+    assert e == "FAIL" and "DEL cuarto" in ev[0], (e, ev)               # S4 ref cargada de otro elemento
+    can4 = dict(can, misc_items=can["misc_items"] + [{"ref": "CLG-Z9-916 board", "qty": 12.0}])
+    assert run("corridor 916 ceiling missing | CERRADO: CLG-Z9-916 (1/X9.31)", can4)[0] == "PASS"   # control: ref DEL cuarto
