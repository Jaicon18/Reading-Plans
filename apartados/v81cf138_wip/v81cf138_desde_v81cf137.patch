+def solo_rev_actual(textos, carpeta=None):
+    """v138 (BE-CR40 S3): de los archivos de hallazgos con la rev en el NOMBRE (BITACORA_rev20.md, RESUMEN_rev19.md, REVIEW_rev9.md) quedan
+    solo los de la rev actual: la de la carpeta de la entrega / del workdir si la trae; si no, la rev MÁS NUEVA entre los nombres. Los
+    archivos sin rev en el nombre quedan todos (COORDINACION/hallazgos.md)."""
+    def rev(n):
+        m = RX_REV_NOMBRE.search(os.path.basename(n))
+        return (int(m.group(1)), m.group(2).lower()) if m else None
+    actual = None
+    if carpeta:
+        m = RX_REV_NOMBRE.search(os.path.basename(os.path.normpath(carpeta)))
+        actual = (int(m.group(1)), m.group(2).lower()) if m else None
+    revs = [r for r in (rev(k) for k in textos) if r]
+    actual = actual or (max(revs) if revs else None)
+    return {k: v for k, v in textos.items() if rev(k) is None or rev(k) == actual}
