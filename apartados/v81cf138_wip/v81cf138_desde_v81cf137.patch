+def test_v138_gk54_gap_medido():
+    """v138 (verificación 6, adv6_gk54, BE-GK54, sintético): un gap_proof 'gap 0' (caso MISMO MURO) se cruza con el gap que el programa
+    mide entre la leaf y la cara de la band (gap_medido_in, descontado medio espesor de cada una): mayor que la tolerancia de dibujo
+    GK54_TOL_DIBUJO_IN = FAIL aunque la frase diga 0; la leaf pegada a la band sigue valiendo."""
+    W = "X9-Z9-08"
+    band = {"ori": "V", "c0": 1509.0, "c1": 1512.8, "lo": 1124.0, "hi": 1163.8, "sheet": "Z9.11"}
+    mid = (band["c0"] + band["c1"]) / 2
+
+    def run(dist_pt, disp):
+        rows = [{"hoja": "Z9.11", "tipo": "muro", "id": "M-29", "x": str(mid - dist_pt), "y": "1145.0", "largo_ft": "4.0",
+                 "estado": "DISPUESTO", "disposicion": disp}]
+        return CE.be_gk54_fallas({"walls": [{"id": W, "band": band}], "excluded_walls": []}, rows)
+    g0 = f"CUBIERTO: same wall as {W}, gap 0\" (1/Z9.11)"
+    assert run(3.0, g0) == []                                            # leaf pegada a la band: gap 0 creíble
+    for d in (9.75, 13.5):                                               # leaf lejos: el programa mide el gap
+        ev = run(d, g0)
+        assert ev and "measures a gap" in ev[0], (d, ev)
+    ex = [{"id": "EX", "wall": W, "reason": f"same wall as {W}", "gap_proof": 'gap 0" (1/Z9.11)',
+           "band": dict(band, c0=1499.0, c1=1502.8)}]
+    ev = CE.be_gk54_fallas({"walls": [{"id": W, "band": band}], "excluded_walls": ex}, [])
+    assert ev and "measures a gap" in ev[0], ev                          # exclusión del canon con band lejos y 'gap 0' = FAIL
+    assert abs(CE.gap_medido_in(10.0, 0.0, 1.0, 1.0, 9.0) - 10.67) < 0.01
+    print("test_v138_gk54_gap_medido OK")
+
+
+test_v138_gk54_gap_medido()
