+    assert CE.version_vigente_en(CE._iso("2026-11-13T01:20:00+00:00")) == "v81cf130"
+    assert CE.version_siguiente("v81cf129") == "v81cf130" and CE.version_siguiente("v81cf130") == "v81cf131"
